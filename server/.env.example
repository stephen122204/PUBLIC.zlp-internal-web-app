MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/zlp_scheduler?retryWrites=true&w=majority&appName=<appName>
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
SESSION_SECRET=change_this_to_a_random_secret
JWT_SECRET=change_this_to_a_random_secret
ADMIN_EMAILS=admin1@tamu.edu,admin2@tamu.edu
CLIENT_BASE_URL=http://localhost:5173
SERVER_BASE_URL=http://localhost:3001
PORT=3001
NODE_ENV=development

# Developer view-switch (local testing only — set to false or omit in production)
ENABLE_DEV_VIEW_SWITCH=false
DEV_EMAILS=developer@tamu.edu

# Howdy API base URL (leave as default unless proxying or mocking locally)
HOWDY_BASE_URL=https://howdy.tamu.edu

# Optional tuning for section fetch timeouts/cache (defaults are fine for dev)
# COURSE_SECTIONS_REQUEST_TIMEOUT_MS=45000
# SECTION_CACHE_TTL_MS=1200000
